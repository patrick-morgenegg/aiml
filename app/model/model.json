  },
  "features": [
    {
      "name": "dl2_success",
      "formula": "1 if the 2nd attempt was good",
      "grows_with_planned_weight": false
    },
    {
      "name": "rel_strength",
      "formula": "ln(DL2 / bodyweight)",
      "grows_with_planned_weight": false
    },
    {
      "name": "log_bodyweight",
      "formula": "ln(bodyweight)",
      "grows_with_planned_weight": false
    },
    {
      "name": "squat_ratio",
      "formula": "ln(best squat / DL2)",
      "grows_with_planned_weight": false
    },
    {
      "name": "bench_ratio",
      "formula": "ln(best bench / DL2)",
      "grows_with_planned_weight": false
    },
    {
      "name": "has_prev_best",
      "formula": "1 if a previous competition best is given",
      "grows_with_planned_weight": false
    },
    {
      "name": "pb_gap",
      "formula": "clip(ln(DL2 / previous best), -0.4, 0.4), 0 without previous best",
      "grows_with_planned_weight": false
    },
    {
      "name": "pb_gap_pos",
      "formula": "max(pb_gap, 0)",
      "grows_with_planned_weight": false
    },
    {
      "name": "equipment_Wraps",
      "formula": "1 if equipment is Wraps (baseline Raw)",
      "grows_with_planned_weight": false
    },
    {
      "name": "equipment_Single-ply",
      "formula": "1 if equipment is Single-ply (baseline Raw)",
      "grows_with_planned_weight": false
    },
    {
      "name": "equipment_Multi-ply",
      "formula": "1 if equipment is Multi-ply (baseline Raw)",
      "grows_with_planned_weight": false
    },
    {
      "name": "equipment_Unlimited",
      "formula": "1 if equipment is Unlimited (baseline Raw)",
      "grows_with_planned_weight": false
    },
    {
      "name": "age_Sub-Junior",
      "formula": "1 if age group is Sub-Junior (baseline Open)",
      "grows_with_planned_weight": false
    },
    {
      "name": "age_Junior",
      "formula": "1 if age group is Junior (baseline Open)",
      "grows_with_planned_weight": false
    },
    {
      "name": "age_Masters",
      "formula": "1 if age group is Masters (baseline Open)",
      "grows_with_planned_weight": false
    },
    {
      "name": "age_Unknown",
      "formula": "1 if age group is Unknown (baseline Open)",
      "grows_with_planned_weight": false
    },
    {
      "name": "jump_after_good",
      "formula": "ln(planned / DL2) if the 2nd attempt was good",
      "grows_with_planned_weight": true
    },
    {
      "name": "jump_after_miss",
      "formula": "ln(planned / DL2) if the 2nd attempt was missed",
      "grows_with_planned_weight": true
    },
    {
      "name": "jump_over_2.5",
      "formula": "max(0, ln(planned / DL2) - ln(1 + 2.5 %))",
      "grows_with_planned_weight": true
    },
    {
      "name": "jump_over_5",
      "formula": "max(0, ln(planned / DL2) - ln(1 + 5 %))",
      "grows_with_planned_weight": true
    },
    {
      "name": "jump_over_7.5",
      "formula": "max(0, ln(planned / DL2) - ln(1 + 7.5 %))",
      "grows_with_planned_weight": true
    },
    {
      "name": "jump_over_10",
      "formula": "max(0, ln(planned / DL2) - ln(1 + 10 %))",
      "grows_with_planned_weight": true
    },
    {
      "name": "pr_excess",
      "formula": "max(0, ln(planned / previous best)) - max(0, ln(DL2 / previous best))",
      "grows_with_planned_weight": true
    }
  ],
